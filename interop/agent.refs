    <qos><reliability><kind>BEST_EFFORT</kind></reliability></qos>
  </data_writer>
  <data_reader profile_name="CounterReader">
    <topic><kind>NO_KEY</kind><name>zz0_interop_counter</name><dataType>CounterStatus</dataType></topic>
    <qos><reliability><kind>BEST_EFFORT</kind></reliability></qos>
  </data_reader>
</profiles>
